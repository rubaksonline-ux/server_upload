{{!-- Partial для отображения статуса пользователя --}}
{{#if user}}
<div class="alert alert-info">
  👋 С возвращением, <strong>{{user.username}}</strong>! 
  Ваш код для обмена: <code>{{user.share_code}}</code>
</div>
{{else}}
<div class="alert alert-warning">
  ℹ️ Вы работаете в режиме анонимной загрузки. 
  <a href="/login">Войдите</a> или <a href="/register">зарегистрируйтесь</a> для доступа ко всем функциям.
</div>
{{/if}}
