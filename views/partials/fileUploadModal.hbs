<!-- Modal загрузки файлов -->
<div class="modal fade" id="uploadModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">📤 Загрузка файла</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="uploadForm">
          <div class="mb-3">
            <label class="form-label">Выберите файл:</label>
            <input type="file" class="form-control" id="fileInput" />
          </div>
          
          <div id="fileInfo" class="d-none">
            <div class="mb-2">
              <label class="form-label text-muted small">Оригинальное имя:</label>
              <input type="text" class="form-control form-control-sm" id="originalName" readonly />
            </div>
            <div class="mb-2">
              <label class="form-label text-muted small">Тип файла:</label>
              <input type="text" class="form-control form-control-sm" id="fileType" readonly />
            </div>
          </div>
          
          <div id="progressContainer" class="mt-3 d-none">
            <div class="d-flex justify-content-between mb-1">
              <small>Прогресс:</small>
              <small id="percentText">0%</small>
            </div>
            <div class="progress">
              <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" 
                   role="progressbar" style="width: 0%"></div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
        <button type="button" class="btn btn-success" id="uploadBtn" disabled>Начать загрузку</button>
      </div>
    </div>
  </div>
</div>
