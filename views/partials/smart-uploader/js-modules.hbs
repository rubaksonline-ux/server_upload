  Smart Uploader - JavaScript Module
  Этот partial содержит весь JavaScript код для работы загрузчика
--}}

<script>
/**
 * ============================================================================
 * 📋 МОДУЛЬ ЛОГИРОВАНИЯ
 * ============================================================================
 */
const Logger = {
  enabled: true,
  prefix: '[SmartUploader]',

  log(module, message, data = null) {
    if (!this.enabled) return;
    const timestamp = new Date().toISOString().split('T')[1].slice(0,8);
    const logMsg = `${this.prefix}[${module}][${timestamp}] ${message}`;
    data !== null ? console.log(logMsg, data) : console.log(logMsg);
  },

  warn(module, message, data = null) {
    if (!this.enabled) return;
    const timestamp = new Date().toISOString().split('T')[1].slice(0,8);
    const logMsg = `${this.prefix}[${module}][WARN][${timestamp}] ${message}`;
    data !== null ? console.warn(logMsg, data) : console.warn(logMsg);
  },

  error(module, message, error = null) {
    const timestamp = new Date().toISOString().split('T')[1].slice(0,8);
    const logMsg = `${this.prefix}[${module}][ERROR][${timestamp}] ${message}`;
    if (error instanceof Error) console.error(logMsg, error);
    else if (error !== null) console.error(logMsg, error);
    else console.error(logMsg);
  },

  group(module, label) { if (this.enabled) console.group(`${this.prefix}[${module}] ${label}`); },
  groupEnd() { if (this.enabled) console.groupEnd(); }
};

/**
 * ============================================================================
 * 🔗 МОДУЛЬ ПРЕВЬЮ ССЫЛОК (Link Preview)
 * ============================================================================
 */
const LinkPreview = {
  // Настройки
  config: {
    apiUrl: '/api/preview', // Эндпоинт вашего бэкенда для парсинга метаданных
    fallbackTimeout: 5000,   // Таймаут для фоллбэка
    maxImageSize: 5 * 1024 * 1024 // 5MB лимит для изображений
  },

  /**
   * Получение метаданных страницы по URL
   * @param {string} url - URL страницы
   * @returns {Promise<Object>} метаданные
   */
  async fetchMetadata(url) {
    Logger.group('LinkPreview', `Запрос метаданных: ${url}`);

    try {
      // Попытка №1: Запрос к нашему API (нужен бэкенд)
      Logger.log('LinkPreview', 'Попытка запроса к API');
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), this.config.fallbackTimeout);

      const response = await fetch(`${this.config.apiUrl}?url=${encodeURIComponent(url)}`, {
        signal: controller.signal,
        headers: { 'Accept': 'application/json' }
      });
      clearTimeout(timeout);

      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json();

      Logger.log('LinkPreview', 'Успешный ответ от API', data);
      Logger.groupEnd();
      return this.normalizeMetadata(data, url);

    } catch (apiError) {
      Logger.warn('LinkPreview', 'API не доступен, используем фоллбэк', apiError);

      // Попытка №2: Фоллбэк через CORS-прокси + базовый парсинг
      try {
        return await this.fetchFallback(url);
      } catch (fallbackError) {
        Logger.warn('LinkPreview', 'Фоллбэк не сработал, возвращаем базовые данные');
        Logger.groupEnd();
        return this.createBasicMetadata(url);
      }
    }
  },

  /**
   * Фоллбэк-метод: парсинг через публичный CORS-прокси
   */
  async fetchFallback(url) {
    Logger.log('LinkPreview', 'Фоллбэк: парсинг через proxy');

    // Используем публичный прокси (в продакшене лучше свой!)
    const proxyUrl = `https://api.allorigins.win/raw?url=${encodeURIComponent(url)}`;

    const response = await fetch(proxyUrl, {
      headers: { 'Accept': 'text/html' }
    });

    if (!response.ok) throw new Error(`Fallback HTTP ${response.status}`);

    const html = await response.text();
    return this.parseHtmlMetadata(html, url);
  },

  /**
   * Парсинг HTML для извлечения мета-тегов
   */
  parseHtmlMetadata(html, baseUrl) {
    Logger.log('LinkPreview', 'Парсинг HTML-метаданных');

    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');

    // Извлекаем Open Graph теги (приоритет)
    const og = {
      title: doc.querySelector('meta[property="og:title"]')?.content,
      description: doc.querySelector('meta[property="og:description"]')?.content,
      image: doc.querySelector('meta[property="og:image"]')?.content,
      url: doc.querySelector('meta[property="og:url"]')?.content
    };

    // Извлекаем Twitter Card теги
    const twitter = {
      title: doc.querySelector('meta[name="twitter:title"]')?.content,
      description: doc.querySelector('meta[name="twitter:description"]')?.content,
      image: doc.querySelector('meta[name="twitter:image"]')?.content
    };

    // Стандартные мета-теги
    const meta = {
      title: doc.querySelector('title')?.textContent?.trim(),
      description: doc.querySelector('meta[name="description"]')?.content
    };

    // Собираем финальные данные с приоритетами
    const result = {
      title: og.title || twitter.title || meta.title || this.extractDomain(baseUrl),
      description: og.description || twitter.description || meta.description || '',
      image: og.image || twitter.image || null,
      url: og.url || baseUrl,
      domain: this.extractDomain(baseUrl),
      favicon: this.extractFavicon(doc, baseUrl)
    };

    // Нормализуем изображение
    if (result.image) {
      result.image = this.resolveImageUrl(result.image, baseUrl);
    }

    Logger.log('LinkPreview', 'Распарсенные метаданные', result);
    return result;
  },

  /**
   * Нормализация данных от API
   */
  normalizeMetadata(data, fallbackUrl) {
    Logger.log('LinkPreview', 'Нормализация данных API');

    return {
      title: data.title || data.ogTitle || data.twitterTitle || this.extractDomain(fallbackUrl),
      description: data.description || data.ogDescription || data.twitterDescription || '',
      image: data.image || data.ogImage || data.twitterImage || null,
      url: data.url || fallbackUrl,
      domain: data.domain || this.extractDomain(fallbackUrl),
      favicon: data.favicon || null
    };
  },

  /**
   * Создание базовых метаданных при ошибке
   */
  createBasicMetadata(url) {
    Logger.log('LinkPreview', 'Создание базовых метаданных');

    return {
      title: this.extractDomain(url),
      description: '',
      image: null,
      url: url,
      domain: this.extractDomain(url),
      favicon: `https://www.google.com/s2/favicons?domain=${this.extractDomain(url)}&sz=32`
    };
  },

  /**
   * Извлечение домена из URL
   */
  extractDomain(url) {
    try {
      let testUrl = url;
      if (!/^https?:\/\//i.test(testUrl)) testUrl = 'https://' + testUrl;
      return new URL(testUrl).hostname.replace(/^www\./, '');
    } catch {
      return url;
    }
  },

  /**
   * Извлечение favicon из HTML
   */
  extractFavicon(doc, baseUrl) {
    const icons = [
      doc.querySelector('link[rel="icon"]')?.href,
      doc.querySelector('link[rel="shortcut icon"]')?.href,
      doc.querySelector('link[rel="apple-touch-icon"]')?.href
    ].filter(Boolean);

    if (icons[0]) {
      return this.resolveImageUrl(icons[0], baseUrl);
    }

    // Фоллбэк на Google favicon service
    return `https://www.google.com/s2/favicons?domain=${this.extractDomain(baseUrl)}&sz=32`;
  },

  /**
   * Преобразование относительного URL изображения в абсолютный
   */
  resolveImageUrl(imageUrl, baseUrl) {
    if (!imageUrl) return null;
    if (imageUrl.startsWith('http')) return imageUrl;
    if (imageUrl.startsWith('//')) return 'https:' + imageUrl;

    try {
      return new URL(imageUrl, baseUrl).href;
    } catch {
      return imageUrl;
    }
  },

  /**
   * Генерация HTML карточки превью
   */
  renderCard(metadata, editable = true) {
    Logger.log('LinkPreview', 'Генерация HTML карточки', { editable, title: metadata.title });

    const hasImage = metadata.image && metadata.image.trim() !== '';
    const imageHtml = hasImage
      ? `<div class="link-preview-image"><img src="${this.escapeHtml(metadata.image)}" alt="" onerror="this.parentElement.classList.add('placeholder'); this.parentElement.innerHTML='<i class=\\'bi bi-image\\'></i>';"></div>`
      : `<div class="link-preview-image placeholder"><i class="bi bi-link-45deg"></i></div>`;

    const editFormHtml = editable ? this.renderEditForm(metadata) : '';

    return `
      <div class="link-preview-card" id="linkPreviewCard">
        ${imageHtml}
        <div class="link-preview-content">
          <div class="link-preview-title" id="previewTitle">${this.escapeHtml(metadata.title)}</div>
          ${metadata.description ? `<div class="link-preview-description" id="previewDescription">${this.escapeHtml(metadata.description)}</div>` : ''}
          <div class="link-preview-meta">
            ${metadata.favicon ? `<img src="${this.escapeHtml(metadata.favicon)}" alt="">` : '<i class="bi bi-globe"></i>'}
            <span class="link-preview-domain">${this.escapeHtml(metadata.domain)}</span>
          </div>
        </div>
        ${editFormHtml}
      </div>
    `;
  },

  /**
   * Генерация формы редактирования
   */
  renderEditForm(metadata) {
    const slug = this.generateSlug(metadata.title);

    return `
      <div class="edit-form" id="editForm">
        <div class="mb-3">
          <label class="edit-form-label" for="editTitle">
            <i class="bi bi-pencil"></i> Заголовок
          </label>
          <input type="text" class="edit-form-input" id="editTitle"
                 value="${this.escapeHtml(metadata.title)}"
                 placeholder="Введите заголовок">
        </div>
        <div class="mb-0">
          <label class="edit-form-label" for="editSlug">
            <i class="bi bi-link-45deg"></i> Slug (URL)
          </label>
          <input type="text" class="edit-form-input" id="editSlug"
                 value="${this.escapeHtml(slug)}"
                 placeholder="url-friendly-name">
          <div class="slug-hint">
            Пример: <code>https://yoursite.com/link/<span id="slugPreview">${this.escapeHtml(slug)}</span></code>
          </div>
        </div>
      </div>
    `;
  },

  /**
   * Генерация slug из строки
   */
  generateSlug(text) {
    if (!text) return 'link';

    // Транслит кириллицы
    const cyrillic = "абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
    const latin = "abvgdeejzijklmnoprstufhczchssh'yieyuABVGDEEJZIJKLMNOPRSTUFHCZCHSSH'YIEYU";

    let slug = text.toLowerCase();
    for (let i = 0; i < cyrillic.length; i++) {
      slug = slug.replace(new RegExp(cyrillic[i], 'g'), latin[i]);
    }

    return slug
      .replace(/[^\w\s-]/g, '')      // Удаляем спецсимволы
      .replace(/[\s_-]+/g, '-')       // Заменяем пробелы/подчёркивания на дефис
      .replace(/^-+|-+$/g, '')        // Удаляем дефисы по краям
      .substring(0, 100) || 'link';   // Ограничиваем длину
  },

  /**
   * Экранирование HTML
   */
  escapeHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  },

  /**
   * Обновление превью в реальном времени при редактировании
   */
  bindLivePreview() {
    const titleInput = document.getElementById('editTitle');
    const slugInput = document.getElementById('editSlug');
    const previewTitle = document.getElementById('previewTitle');
    const slugPreview = document.getElementById('slugPreview');

    if (titleInput && previewTitle) {
      titleInput.addEventListener('input', (e) => {
        previewTitle.textContent = e.target.value || 'Без заголовка';
        // Автогенерация slug при изменении заголовка (если slug не редактировался вручную)
        if (slugInput && !slugInput.dataset.manuallyEdited) {
          slugInput.value = this.generateSlug(e.target.value);
          if (slugPreview) slugPreview.textContent = slugInput.value;
        }
      });
    }

    if (slugInput) {
      slugInput.addEventListener('input', (e) => {
        slugInput.dataset.manuallyEdited = 'true';
        if (slugPreview) slugPreview.textContent = e.target.value;
      });
      // Отслеживаем фокус для определения ручного редактирования
      slugInput.addEventListener('focus', () => {
        slugInput.dataset.manuallyEdited = 'true';
      });
    }

    Logger.log('LinkPreview', 'Live preview привязан');
  }
};

/**
 * ============================================================================
 * 🔍 МОДУЛЬ АНАЛИЗА КОНТЕНТА
 * ============================================================================
 */
const ContentAnalyzer = {
  patterns: {
    url: /^(https?:\/\/)?([\da-z\.-]+)\.([a-z\.]{2,6})([\/\w \.-]*)*\/?$/i,
    urlStrict: /^https?:\/\/(www\.)?[-a-zA-Z0-9@:%._+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_+.~#?&//=]*)$/i,
    telegram: /^@[\w_]{3,32}$/i,
    telegramLink: /^https?:\/\/t\.me\/[\w_]{3,32}\/?$/i,
    email: /^[\w.-]+@[\w.-]+\.\w{2,}$/i,
    phone: /^[\+]?[(]?[0-9]{1,4}[)]?[-\s\.]?[0-9]{3}[-\s\.]?[0-9]{3,8}$/,
    gps: /^[-+]?([1-8]?\d(\.\d+)?|90(\.0+)?),\s*[-+]?(180(\.0+)?|((1[0-7]\d)|([1-9]?\d))(\.\d+)?)$/,
    ip: /^(\d{1,3}\.){3}\d{1,3}$/,
    hexColor: /^#?([a-f0-9]{6}|[a-f0-9]{3})$/i
  },

  countryCodes: {
    '1': 'США/Канада', '7': 'Россия/Казахстан', '20': 'Египет', '27': 'ЮАР',
    '30': 'Греция', '31': 'Нидерланды', '32': 'Бельгия', '33': 'Франция',
    '34': 'Испания', '36': 'Венгрия', '39': 'Италия', '40': 'Румыния',
    '41': 'Швейцария', '43': 'Австрия', '44': 'Великобритания', '45': 'Дания',
    '46': 'Швеция', '47': 'Норвегия', '48': 'Польша', '49': 'Германия',
    '51': 'Перу', '52': 'Мексика', '53': 'Куба', '54': 'Аргентина',
    '55': 'Бразилия', '56': 'Чили', '57': 'Колумбия', '58': 'Венесуэла',
    '60': 'Малайзия', '61': 'Австралия', '62': 'Индонезия', '63': 'Филиппины',
    '64': 'Новая Зеландия', '65': 'Сингапур', '66': 'Таиланд', '81': 'Япония',
    '82': 'Южная Корея', '84': 'Вьетнам', '86': 'Китай', '90': 'Турция',
    '91': 'Индия', '92': 'Пакистан', '93': 'Афганистан', '94': 'Шри-Ланка',
    '95': 'Мьянма', '98': 'Иран', '380': 'Украина', '375': 'Беларусь',
    '995': 'Грузия', '994': 'Азербайджан', '996': 'Киргизия', '998': 'Узбекистан',
    '992': 'Таджикистан', '993': 'Туркменистан'
  },

  analyze(input) {
    Logger.group('ContentAnalyzer', 'Начало анализа');
    Logger.log('ContentAnalyzer', 'Входные данные:', { input, length: input?.length });

    if (!input || typeof input !== 'string') {
      Logger.warn('ContentAnalyzer', 'Пустой или некорректный ввод');
      Logger.groupEnd();
      return { type: 'empty', value: null, confidence: 0 };
    }

    const text = input.trim();
    if (!text) {
      Logger.log('ContentAnalyzer', 'Пустая строка после trim()');
      Logger.groupEnd();
      return { type: 'empty', value: null, confidence: 0 };
    }

    const checks = [
      { name: 'telegramLink', test: () => this.isTelegramLink(text), handler: () => this.handleTelegramLink(text) },
      { name: 'url', test: () => this.isUrl(text), handler: () => this.handleUrl(text) },
      { name: 'telegram', test: () => this.isTelegramNick(text), handler: () => this.handleTelegramNick(text) },
      { name: 'email', test: () => this.isEmail(text), handler: () => this.handleEmail(text) },
      { name: 'phone', test: () => this.isPhone(text), handler: () => this.handlePhone(text) },
      { name: 'gps', test: () => this.isGps(text), handler: () => this.handleGps(text) },
      { name: 'ip', test: () => this.isIp(text), handler: () => this.handleIp(text) },
      { name: 'hexColor', test: () => this.isHexColor(text), handler: () => this.handleHexColor(text) }
    ];

    for (const check of checks) {
      if (check.test()) {
        const result = check.handler();
        Logger.log('ContentAnalyzer', `Обнаружен тип: ${result.type}`, result);
        Logger.groupEnd();
        return result;
      }
    }

    const result = this.handleText(text);
    Logger.log('ContentAnalyzer', 'Тип по умолчанию: text', result);
    Logger.groupEnd();
    return result;
  },

  // === Валидаторы ===
  isUrl(str) {
    Logger.log('ContentAnalyzer', `Проверка URL: "${str}"`);
    try {
      let testStr = str;
      if (!/^https?:\/\//i.test(testStr)) testStr = 'https://' + testStr;
      const url = new URL(testStr);
      const isValid = url.hostname && url.hostname.includes('.');
      Logger.log('ContentAnalyzer', `URL валидация: ${isValid}`, { hostname: url.hostname });
      return isValid;
    } catch(e) {
      Logger.log('ContentAnalyzer', `URL валидация: false (ошибка парсинга)`);
      return false;
    }
  },

  isTelegramNick(str) { const r = this.patterns.telegram.test(str); Logger.log('ContentAnalyzer', `Telegram @: ${r}`); return r; },
  isTelegramLink(str) { const r = this.patterns.telegramLink.test(str); Logger.log('ContentAnalyzer', `Telegram link: ${r}`); return r; },
  isEmail(str) { const r = this.patterns.email.test(str); Logger.log('ContentAnalyzer', `Email: ${r}`); return r; },
  isPhone(str) { const c = str.replace(/[\s\-\(\)\.]/g, ''); const r = this.patterns.phone.test(c); Logger.log('ContentAnalyzer', `Phone: ${r}`); return r; },
  isGps(str) { const r = this.patterns.gps.test(str); Logger.log('ContentAnalyzer', `GPS: ${r}`); return r; },
  isIp(str) { const r = this.patterns.ip.test(str); Logger.log('ContentAnalyzer', `IP: ${r}`); return r; },
  isHexColor(str) { const r = this.patterns.hexColor.test(str); Logger.log('ContentAnalyzer', `Color: ${r}`); return r; },

  // === Обработчики ===
  handleUrl(str) {
    let testStr = str;
    if (!/^https?:\/\//i.test(testStr)) testStr = 'https://' + testStr;
    try {
      const url = new URL(testStr);
      return {
        type: 'url', value: str,
        parsed: { protocol: url.protocol, hostname: url.hostname, pathname: url.pathname, domain: url.hostname.replace(/^www\./, '') },
        confidence: 1,
        icon: `https://www.google.com/s2/favicons?domain=${url.hostname}&sz=32`
      };
    } catch(e) { return { type: 'url', value: str, confidence: 0.8 }; }
  },

  handleTelegramNick(str) { return { type: 'telegram', value: str, username: str.replace(/^@/, ''), link: `https://t.me/${str.replace(/^@/, '')}`, confidence: 1 }; },
  handleTelegramLink(str) { const u = str.match(/t\.me\/([\w_]+)/i)?.[1] || ''; return { type: 'telegram', value: str, username: u, isLink: true, confidence: 1 }; },
  handleEmail(str) { const [l,d] = str.split('@'); return { type: 'email', value: str, localPart: l, domain: d, confidence: 1 }; },
  handlePhone(str) { const c = str.replace(/[^\d+]/g, ''); const country = this.detectCountryByPhone(c); return { type: 'phone', value: str, cleaned: c, country, confidence: country ? 0.95 : 0.7 }; },
  handleGps(str) { const [lat, lng] = str.split(',').map(c => parseFloat(c.trim())); return { type: 'gps', value: str, coordinates: { lat, lng }, mapLink: `https://www.google.com/maps?q=${lat},${lng}`, confidence: 1 }; },
  handleIp(str) { return { type: 'ip', value: str, confidence: 1 }; },
  handleHexColor(str) { const hex = str.startsWith('#') ? str : '#' + str; return { type: 'color', value: str, hex: hex.toUpperCase(), confidence: 1 }; },
  handleText(str) { return { type: 'text', value: str, length: str.length, words: str.split(/\s+/).filter(w => w).length, confidence: 1 }; },

  detectCountryByPhone(phoneClean) {
    Logger.log('ContentAnalyzer', 'Определение страны:', { phoneClean });
    const sorted = Object.keys(this.countryCodes).sort((a,b) => b.length - a.length);
    for (const code of sorted) {
      if (phoneClean.startsWith(code)) {
        Logger.log('ContentAnalyzer', `Код ${code} → ${this.countryCodes[code]}`);
        return this.countryCodes[code];
      }
    }
    return null;
  },

  renderResult(result) {
    Logger.log('ContentAnalyzer', 'Генерация HTML результата', result);
    const config = {
      url: { icon: '🌐', label: 'URL-ссылка', class: 'url' },
      telegram: { icon: '✈️', label: 'Telegram', class: 'telegram' },
      email: { icon: '📧', label: 'Email', class: 'email' },
      phone: { icon: '📱', label: 'Телефон', class: 'phone' },
      gps: { icon: '📍', label: 'GPS', class: 'gps' },
      ip: { icon: '🔢', label: 'IP', class: 'text' },
      color: { icon: '🎨', label: 'Цвет', class: 'text' },
      text: { icon: '📝', label: 'Текст', class: 'text' }
    };
    const c = config[result.type] || config.text;

    let meta = '';
    if (result.type === 'url' && result.parsed) meta = `<div class="analysis-meta">Домен: ${result.parsed.domain}</div>`;
    else if (result.type === 'telegram') meta = `<div class="analysis-meta">@${result.username}</div>`;
    else if (result.type === 'email') meta = `<div class="analysis-meta">${result.domain}</div>`;
    else if (result.type === 'phone' && result.country) meta = `<div class="analysis-meta">${result.country}</div>`;
    else if (result.type === 'text') meta = `<div class="analysis-meta">${result.length} симв.</div>`;

    return `<div class="analysis-result"><div class="analysis-icon ${c.class}">${c.icon}</div><div class="analysis-content"><div class="analysis-label">${c.label}</div><div class="analysis-value">${ContentAnalyzer.escapeHtml(result.value)}</div>${meta}</div></div>`;
  },

  escapeHtml(str) { if (!str) return ''; const d = document.createElement('div'); d.textContent = str; return d.innerHTML; }
};
</script>
