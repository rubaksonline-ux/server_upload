<!-- УНИВЕРСАЛЬНОЕ ПОЛЕ ВВОДА + ИКОНКИ -->
<div class="smart-input-group d-flex align-items-center flex-wrap">
  <div id="siteIconZone" class="me-2"></div>
  <input type="text" class="form-control-smart flex-grow-1" id="universalInput"
         placeholder="Вставьте ссылку, текст, или выберите файл через иконки..." autocomplete="off">
  <div class="d-flex gap-1 ms-2">
    <button class="btn btn-icon-action" id="pasteBtn" title="Вставить из буфера"><i class="bi bi-clipboard-plus fs-6"></i></button>
    <button class="btn btn-icon-action" id="cameraBtn" title="Сделать фото"><i class="bi bi-camera fs-6"></i></button>
    <button class="btn btn-icon-action" id="uploadAnyBtn" title="Загрузить файл"><i class="bi bi-paperclip fs-6"></i></button>
  </div>
</div>
