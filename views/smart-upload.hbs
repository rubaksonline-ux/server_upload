{{!-- 
  Пример использования Smart Uploader
  
  Эта страница демонстрирует как использовать шаблон smart-uploader
  в вашем Handlebars приложении.
--}}

{{layout "main"}}

{{#*inline "content"}}
<div class="row justify-content-center">
  <div class="col-lg-8">
    {{> smart-uploader }}
  </div>
</div>
{{/inline}}
